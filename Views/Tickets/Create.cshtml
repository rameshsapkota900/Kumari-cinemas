@model Ticket
@{
    ViewData["Title"] = "Add New Ticket";
    var ticketPrices = ViewBag.TicketPrices as List<TicketPrice> ?? new List<TicketPrice>();
    var seats = ViewBag.Seats as List<Seat> ?? new List<Seat>();
    var cancellations = ViewBag.Cancellations as List<Cancellation> ?? new List<Cancellation>();
}

<div class="page-header">
    <h2><i class="bi bi-ticket-perforated me-2"></i>Issue New Ticket</h2>
    <p>Create a new ticket with pricing and seat assignment</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="form-section">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="TicketPriceID" class="form-label">Ticket Price <span class="text-danger">*</span></label>
                        <select asp-for="TicketPriceID" class="form-select" required>
                            <option value="">-- Select Price --</option>
                            @foreach (var tp in ticketPrices)
                            {
                                <option value="@tp.TicketPriceID">Rs. @tp.Price.ToString("F2") — @tp.Category</option>
                            }
                        </select>
                        <small class="text-muted">Choose ticket pricing category</small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SeatID" class="form-label">Assign Seat <span class="text-danger">*</span></label>
                        <select asp-for="SeatID" class="form-select" required>
                            <option value="">-- Select Seat --</option>
                            @foreach (var s in seats)
                            {
                                <option value="@s.SeatID">@s.SeatNumber — @s.Status</option>
                            }
                        </select>
                        <small class="text-muted">Select an available seat</small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CancellationID" class="form-label">Cancellation <span class="text-muted">- Optional</span></label>
                        <select asp-for="CancellationID" class="form-select">
                            <option value="">-- No Cancellation --</option>
                            @foreach (var c in cancellations)
                            {
                                <option value="@c.CancellationID">@(c.CancelDate?.ToString("yyyy-MM-dd") ?? "-") — @c.Reason</option>
                            }
                        </select>
                        <small class="text-muted">Link to a cancellation record if applicable</small>
                    </div>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back</a>
                    <button type="submit" class="btn btn-kumari"><i class="bi bi-check-circle me-2"></i>Create Ticket</button>
                </div>
            </form>
        </div>
    </div>
</div>
