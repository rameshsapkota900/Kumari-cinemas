@model Cancellation
@{
    ViewData["Title"] = "Edit Cancellation";
}

<div class="page-header">
    <h2><i class="bi bi-pencil-square me-2"></i>Edit Cancellation #@Model.CancellationID</h2>
    <p>Update cancellation record details</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="form-section">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CancellationID" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Reason" class="form-label">Reason</label>
                        <select asp-for="Reason" class="form-select">
                            <option value="">-- Select Reason --</option>
                            <option value="Customer Request">Customer Request</option>
                            <option value="Schedule Change">Schedule Change</option>
                            <option value="Show Cancelled">Show Cancelled</option>
                            <option value="Payment Issue">Payment Issue</option>
                            <option value="Double Booking">Double Booking</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CancelDate" class="form-label">Cancellation Date</label>
                        <input asp-for="CancelDate" type="date" class="form-control" value="@Model.CancelDate?.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back</a>
                    <button type="submit" class="btn btn-kumari"><i class="bi bi-save me-2"></i>Update Cancellation</button>
                </div>
            </form>
        </div>
    </div>
</div>
