@model Movie
@{
    ViewData["Title"] = "Edit Movie";
}

<div class="page-header">
    <h2><i class="bi bi-pencil-square me-2"></i>Edit Movie</h2>
    <p>Update movie information in the catalogue</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="form-section">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MovieID" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Movie ID</label>
                        <input value="@Model.MovieID" class="form-control" disabled />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label">Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" maxlength="50" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Duration" class="form-label">Duration (mins) <span class="text-danger">*</span></label>
                        <input asp-for="Duration" type="number" class="form-control" min="1" max="999" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Language" class="form-label">Language <span class="text-danger">*</span></label>
                        <input asp-for="Language" class="form-control" maxlength="20" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Genre" class="form-label">Genre <span class="text-danger">*</span></label>
                        <input asp-for="Genre" class="form-control" maxlength="20" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ReleaseDate" class="form-label">Release Date <span class="text-danger">*</span></label>
                        <input asp-for="ReleaseDate" type="date" class="form-control" value="@Model.ReleaseDate.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back</a>
                    <button type="submit" class="btn btn-kumari"><i class="bi bi-save me-2"></i>Update Movie</button>
                </div>
            </form>
        </div>
    </div>
</div>
