@model UserTicketViewModel
@{
    ViewData["Title"] = "User Ticket History Report";
}

<!-- Page Header -->
<div class="page-header mb-5">
    <h1 class="display-5" style="color: #ffd700; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
        <i class="bi bi-person-badge me-3"></i>User Ticket History Report
    </h1>
    <p style="color: #b0b0b0;">View ticket purchase history for any registered user (last 6 months, paid tickets only)</p>
</div>

<!-- User Selection Filter -->
<div class="filter-card mb-5" style="background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%); border: 2px solid #333333; border-radius: 12px; padding: 24px;">
    <form method="get" class="row align-items-end g-3">
        <div class="col-md-7">
            <label class="form-label" style="color: #ffd700; font-weight: 600;">
                <i class="bi bi-person me-2"></i>Select User
            </label>
            <select name="userId" class="form-select form-select-cinema" onchange="this.form.submit()">
                <option value="">-- Choose a User --</option>
                @foreach (var u in Model.AllUsers)
                {
                    <option value="@u.UserID" selected="@(Model.SelectedUserId == u.UserID ? "selected" : null)">
                        @u.FullName (@u.Username) — @u.Email
                    </option>
                }
            </select>
            <small style="color: #b0b0b0;">Select a customer to view their booking history</small>
        </div>
        <div class="col-md-5 d-flex gap-2">
            <button type="submit" class="btn btn-kumari flex-grow-1" style="background: linear-gradient(135deg, #e50914 0%, #b20710 100%); border: none;">
                <i class="bi bi-search me-2"></i>Load Tickets
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary" style="border-color: #666; color: #b0b0b0; padding: 10px 20px;">
                <i class="bi bi-x-circle me-2"></i>Clear
            </a>
        </div>
    </form>
</div>

@if (Model.SelectedUserId.HasValue && Model.SelectedUser != null)
{
    <!-- User Details Card -->
    <div class="card mb-5" style="background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%); border: 2px solid #333333; border-left: 4px solid #e50914; border-radius: 12px;">
        <div class="card-header" style="background: transparent; border-bottom: 1px solid #333;">
            <h4 class="mb-0" style="color: #ffd700;">
                <i class="bi bi-person-circle me-2"></i>Customer Details
            </h4>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-3">
                    <div style="color: #b0b0b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">Username</div>
                    <div style="color: #f0f0f0; font-weight: 600; font-size: 16px; margin-top: 4px;">@Model.SelectedUser.Username</div>
                </div>
                <div class="col-md-3">
                    <div style="color: #b0b0b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">Full Name</div>
                    <div style="color: #f0f0f0; font-weight: 600; font-size: 16px; margin-top: 4px;">@Model.SelectedUser.FullName</div>
                </div>
                <div class="col-md-3">
                    <div style="color: #b0b0b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">Email</div>
                    <div style="color: #f0f0f0; font-weight: 600; font-size: 16px; margin-top: 4px;">@Model.SelectedUser.Email</div>
                </div>
                <div class="col-md-3">
                    <div style="color: #b0b0b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">Phone</div>
                    <div style="color: #f0f0f0; font-weight: 600; font-size: 16px; margin-top: 4px;">@Model.SelectedUser.Phone</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tickets Table -->
    <div class="card" style="background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%); border: 2px solid #333333; border-radius: 12px;">
        <div class="card-header" style="background: linear-gradient(135deg, #e50914 0%, #b20710 100%); border: none;">
            <h4 class="mb-0 text-white">
                <i class="bi bi-ticket-perforated me-2"></i>Tickets Purchased (Last 6 Months - Paid Only)
            </h4>
        </div>
        <div class="card-body p-0">
            @if (Model.Tickets.Any())
            {
                <div class="table-responsive">
                    <table class="table table-kumari table-hover mb-0">
                        <thead>
                            <tr>
                                <th>TicketID</th>
                                <th>Movie</th>
                                <th>Issue Date</th>
                                <th>Price (Rs.)</th>
                                <th>Category</th>
                                <th>Seat No.</th>
                                <th>Show Date</th>
                                <th>Show Time</th>
                                <th>Booking</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Tickets)
                            {
                                <tr>
                                    <td><strong>@t.TicketID</strong></td>
                                    <td>@t.MovieTitle</td>
                                    <td>@t.IssueDate.ToString("yyyy-MM-dd")</td>
                                    <td><strong>Rs. @t.Price.ToString("F2")</strong></td>
                                    <td><span class="badge bg-info">@t.Category</span></td>
                                    <td>@t.SeatNumber</td>
                                    <td>@t.ShowDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge bg-secondary">@t.ShowTime</span></td>
                                    <td><span class="badge bg-primary">@t.BookingDate.ToString("yyyy-MM-dd")</span></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background: rgba(255, 215, 0, 0.1); border-top: 2px solid #ffd700;">
                                <td colspan="3" class="text-end" style="color: #ffd700; font-weight: 700; padding: 16px;">
                                    <i class="bi bi-calculator me-2"></i>Total (@Model.Tickets.Count paid tickets):
                                </td>
                                <td style="color: #ffd700; font-weight: 700; font-size: 18px; padding: 16px;">
                                    Rs. @Model.Tickets.Sum(t => t.Price).ToString("F2")
                                </td>
                                <td colspan="5"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-2">No tickets found for this user in the last 6 months.</p>
                </div>
            }
        </div>
    </div>

    <div class="card-footer" style="background: transparent; border-top: 1px solid #333; padding: 16px 20px;">
        <small style="color: #b0b0b0;">
            <i class="bi bi-info-circle me-1"></i>
            Report shows all tickets for the selected customer purchased in the last 6 months with confirmed/paid payment status.
        </small>
    </div>
}
