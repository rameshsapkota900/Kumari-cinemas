@model OccupancyViewModel
@{
    ViewData["Title"] = "Theater Occupancy Analytics";
}

<!-- Page Header -->
<div class="page-header mb-5">
    <h1 class="display-5" style="color: #ffd700; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
        <i class="bi bi-bar-chart me-3"></i>Theater Occupancy Analytics
    </h1>
    <p style="color: #b0b0b0;">Analyze seat occupancy for each movie across all theater locations (paid tickets only)</p>
</div>

<!-- Movie Selection Filter -->
<div class="filter-card mb-5" style="background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%); border: 2px solid #333333; border-radius: 12px; padding: 24px;">
    <form method="get" class="row align-items-end g-3">
        <div class="col-md-7">
            <label class="form-label" style="color: #ffd700; font-weight: 600;">
                <i class="bi bi-film me-2"></i>Select Movie for Analysis
            </label>
            <select name="movieId" class="form-select form-select-cinema" onchange="this.form.submit()">
                <option value="">-- Choose a Movie --</option>
                @foreach (var m in Model.AllMovies)
                {
                    <option value="@m.MovieID" selected="@(Model.SelectedMovieId == m.MovieID ? "selected" : null)">
                        @m.Title (@m.Genre, @m.Language)
                    </option>
                }
            </select>
            <small style="color: #b0b0b0;">Select a movie to view top 3 performing theaters</small>
        </div>
        <div class="col-md-5 d-flex gap-2">
            <button type="submit" class="btn btn-kumari flex-grow-1" style="background: linear-gradient(135deg, #e50914 0%, #b20710 100%); border: none;">
                <i class="bi bi-search me-2"></i>Analyze Occupancy
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary" style="border-color: #666; color: #b0b0b0; padding: 10px 20px;">
                <i class="bi bi-x-circle me-2"></i>Clear
            </a>
        </div>
    </form>
</div>

@if (Model.SelectedMovieId.HasValue && Model.SelectedMovie != null)
{
    <!-- Movie Info -->
    <div class="card mb-5" style="background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%); border: 2px solid #333333; border-left: 4px solid #e50914; border-radius: 12px;">
        <div class="card-header" style="background: transparent; border-bottom: 1px solid #333;">
            <h4 class="mb-0" style="color: #ffd700;">
                <i class="bi bi-film me-2"></i>Movie Details
            </h4>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-4">
                    <div style="color: #b0b0b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">Movie Title</div>
                    <div style="color: #f0f0f0; font-weight: 600; font-size: 18px; margin-top: 4px;">@Model.SelectedMovie.Title</div>
                </div>
                <div class="col-md-4">
                    <div style="color: #b0b0b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">Genre</div>
                    <span class="badge" style="background: rgba(59, 130, 246, 0.2); color: #3b82f6; border: 1px solid #3b82f6; font-size: 12px; padding: 4px 8px;">@Model.SelectedMovie.Genre</span>
                </div>
                <div class="col-md-4">
                    <div style="color: #b0b0b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">Language</div>
                    <div style="color: #f0f0f0; font-weight: 600; font-size: 14px; margin-top: 4px;">@Model.SelectedMovie.Language</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Occupancy Results -->
    <div class="card" style="background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%); border: 2px solid #333333; border-radius: 12px;">
        <div class="card-header" style="background: linear-gradient(135deg, #ffd700 0%, #daa520 100%); border: none;">
            <h4 class="mb-0" style="color: #1a1a2e;">
                <i class="bi bi-trophy me-2"></i>Top 3 Theater/Hall Occupancy (Paid Tickets Only)
            </h4>
        </div>
        <div class="card-body">
            @if (Model.TopTheaters.Any())
            {
                int rank = 1;
                @foreach (var r in Model.TopTheaters)
                {
                    var medalColor = rank == 1 ? "#ffd700" : rank == 2 ? "#c0c0c0" : "#cd7f32";
                    var medalBgColor = rank == 1 ? "rgba(255, 215, 0, 0.1)" : rank == 2 ? "rgba(192, 192, 192, 0.1)" : "rgba(205, 127, 50, 0.1)";
                    var occupancyColor = r.OccupancyPercentage >= 80 ? "#10b981" : r.OccupancyPercentage >= 50 ? "#3b82f6" : "#f59e0b";

                    <div class="occupancy-bar mb-4 p-4 rounded" style="background: @medalBgColor; border-left: 5px solid @medalColor; border-radius: 12px;">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <span style="background: @medalColor; color: @(rank == 1 ? "#1a1a2e" : "#f0f0f0"); padding: 6px 12px; border-radius: 6px; font-weight: 700; margin-right: 12px; display: inline-block;">
                                    #@rank @(rank == 1 ? "🥇 GOLD" : rank == 2 ? "🥈 SILVER" : "🥉 BRONZE")
                                </span>
                                <div style="display: inline-block;">
                                    <div style="color: #ffd700; font-weight: 700; font-size: 16px;">@r.TheaterName</div>
                                    <div style="color: #b0b0b0; font-size: 14px;">@r.HallName <i class="bi bi-geo-alt"></i> @r.City</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div style="color: @occupancyColor; font-weight: 700; font-size: 24px;">@r.OccupancyPercentage%</div>
                                <small style="color: #b0b0b0;">Occupancy</small>
                            </div>
                        </div>

                        <!-- Progress Bar -->
                        <div class="progress" style="height: 28px; background: rgba(0,0,0,0.3); border-radius: 6px;">
                            <div class="progress-bar" 
                                 style="width: @r.OccupancyPercentage%; background: linear-gradient(90deg, @occupancyColor 0%, @(r.OccupancyPercentage >= 80 ? "#059669" : r.OccupancyPercentage >= 50 ? "#2563eb" : "#f97316") 100%); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600;"
                                 role="progressbar"
                                 aria-valuenow="@r.OccupancyPercentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                                @r.PaidTickets / @r.Capacity seats
                            </div>
                        </div>

                        <!-- Stats Row -->
                        <div class="row mt-3 text-center">
                            <div class="col-4">
                                <div style="color: #b0b0b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">Total Capacity</div>
                                <div style="color: #ffd700; font-weight: 700; font-size: 16px; margin-top: 4px;">@r.Capacity seats</div>
                            </div>
                            <div class="col-4">
                                <div style="color: #b0b0b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">Paid Tickets</div>
                                <div style="color: #10b981; font-weight: 700; font-size: 16px; margin-top: 4px;">@r.PaidTickets</div>
                            </div>
                            <div class="col-4">
                                <div style="color: #b0b0b0; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">Available Seats</div>
                                <div style="color: #3b82f6; font-weight: 700; font-size: 16px; margin-top: 4px;">@(r.Capacity - r.PaidTickets)</div>
                            </div>
                        </div>
                    </div>
                    rank++;
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-2">No occupancy data found for this movie (no paid bookings).</p>
                </div>
            }
        </div>
    </div>
}
