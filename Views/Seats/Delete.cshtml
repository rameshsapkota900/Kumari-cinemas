@model Seat
@{
    ViewData["Title"] = "Delete Seat";
    var hallLookup = ViewBag.HallLookup as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="page-header">
    <h2><i class="bi bi-trash me-2"></i>Delete Seat #@Model.SeatID</h2>
    <p>Remove this seat from the system</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="delete-confirm text-center">
            <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
            <h4 class="mt-3">Delete Seat "@Model.SeatNumber"?</h4>
            <p class="text-muted">Hall: @(hallLookup.ContainsKey(Model.HallID) ? hallLookup[Model.HallID] : $"#{Model.HallID}") | Status: @Model.Status</p>
            <p class="text-warning small"><i class="bi bi-info-circle me-1"></i>This will fail if tickets are assigned to this seat.</p>
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.SeatID" />
                <a asp-action="Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left me-2"></i>Cancel</a>
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-2"></i>Confirm Delete</button>
            </form>
        </div>
    </div>
</div>
