@model Seat
@{
    ViewData["Title"] = "Add Seat";
    var halls = ViewBag.Halls as List<Hall> ?? new List<Hall>();
}

<div class="page-header">
    <h2><i class="bi bi-grid-3x3-gap me-2"></i>Add New Seat</h2>
    <p>Add a seat to a screening hall</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="form-section">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="SeatNumber" class="form-label">Seat Number <span class="text-danger">*</span></label>
                        <input asp-for="SeatNumber" class="form-control" placeholder="e.g. A1, B5, C12" maxlength="10" required />
                        <small class="text-muted">Unique seat identifier within the hall</small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="HallID" class="form-label">Screening Hall <span class="text-danger">*</span></label>
                        <select asp-for="HallID" class="form-select" required>
                            <option value="">-- Select Hall --</option>
                            @foreach (var h in halls)
                            {
                                <option value="@h.HallID">@h.HallName — @h.TheaterName (@h.TheaterCity)</option>
                            }
                        </select>
                        <small class="text-muted">Which hall does this seat belong to?</small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">Status <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="form-select" required>
                            <option value="Available">Available</option>
                            <option value="Occupied">Occupied</option>
                            <option value="Reserved">Reserved</option>
                            <option value="Maintenance">Maintenance</option>
                        </select>
                    </div>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back</a>
                    <button type="submit" class="btn btn-kumari"><i class="bi bi-check-circle me-2"></i>Create Seat</button>
                </div>
            </form>
        </div>
    </div>
</div>
