@model TheaterCityHallViewModel
@{
    ViewData["Title"] = "Theater & Hall Management";
}

<!-- Page Header with Statistics -->
<div class="page-header mb-5">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="display-5" style="color: #ffd700; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
                <i class="bi bi-building me-3"></i>Theater & Hall Management
            </h1>
            <p style="color: #b0b0b0; font-size: 16px;">Manage cinema locations and screening halls</p>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="stat-card theaters h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi bi-building stat-icon"></i>
                        <div class="stat-label">Total Theaters</div>
                        <div class="stat-value">@Model.Theaters.Count</div>
                    </div>
                    <a asp-action="CreateTheater" class="btn btn-kumari" style="background: linear-gradient(135deg, #e50914 0%, #b20710 100%); border: none;">
                        <i class="bi bi-plus-lg"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card halls h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi bi-door-open stat-icon"></i>
                        <div class="stat-label">Total Halls</div>
                        <div class="stat-value">@Model.Halls.Count</div>
                    </div>
                    <a asp-action="CreateHall" class="btn btn-kumari" style="background: linear-gradient(135deg, #e50914 0%, #b20710 100%); border: none;">
                        <i class="bi bi-plus-lg"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- THEATERS Section -->
<div class="card theater-management-card mb-5">
    <div class="card-header" style="background: linear-gradient(135deg, #e50914 0%, #b20710 100%); border: none;">
        <h4 class="mb-0 text-white">
            <i class="bi bi-building me-2"></i>Theaters
        </h4>
    </div>
    
    @if (!Model.Theaters.Any())
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox" style="font-size: 48px; color: #666;"></i>
            <p class="text-muted mt-3">No theaters configured yet.</p>
        </div>
    }
    else
    {
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-kumari table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Theater Name</th>
                            <th>Location</th>
                            <th>Address</th>
                            <th style="width: 120px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Theaters)
                        {
                            <tr>
                                <td><strong style="color: #ffd700;">@t.TheaterID</strong></td>
                                <td style="color: #f0f0f0;"><i class="bi bi-star-fill" style="color: #ffd700; margin-right: 6px;"></i>@t.Name</td>
                                <td style="color: #b0b0b0;"><i class="bi bi-geo-alt" style="color: #ffd700; margin-right: 6px;"></i>@t.City</td>
                                <td style="color: #b0b0b0;">@t.Address</td>
                                <td class="text-center">
                                    <a asp-action="EditTheater" asp-route-id="@t.TheaterID" class="btn btn-sm btn-edit" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="DeleteTheater" asp-route-id="@t.TheaterID" class="btn btn-sm btn-delete" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- HALLS Section -->
<div class="card theater-management-card">
    <div class="card-header" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none;">
        <h4 class="mb-0 text-white">
            <i class="bi bi-door-open me-2"></i>Screening Halls
        </h4>
    </div>
    
    @if (!Model.Halls.Any())
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox" style="font-size: 48px; color: #666;"></i>
            <p class="text-muted mt-3">No halls configured yet.</p>
        </div>
    }
    else
    {
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-kumari table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Hall Name</th>
                            <th>Theater</th>
                            <th>Capacity</th>
                            <th>Configuration</th>
                            <th style="width: 120px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Halls)
                        {
                            <tr>
                                <td><strong style="color: #ffd700;">@h.HallID</strong></td>
                                <td style="color: #f0f0f0;"><i class="bi bi-film" style="color: #10b981; margin-right: 6px;"></i>@h.HallName</td>
                                <td style="color: #b0b0b0;">@h.TheaterName</td>
                                <td>
                                    <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #10b981; border: 1px solid #10b981;">
                                        @h.Capacity seats
                                    </span>
                                </td>
                                <td style="color: #b0b0b0;">
                                    @if (h.Capacity > 0)
                                    {
                                        <small>10-seat rows</small>
                                    }
                                    else
                                    {
                                        <small style="color: #f59e0b;">Not configured</small>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="EditHall" asp-route-id="@h.HallID" class="btn btn-sm btn-edit" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="DeleteHall" asp-route-id="@h.HallID" class="btn btn-sm btn-delete" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .theater-management-card {
        background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%);
        border: 2px solid #333333;
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .theater-management-card:hover {
        border-color: #ffd700;
        box-shadow: 0 10px 30px rgba(229, 9, 20, 0.2);
    }

    .theater-management-card .card-header {
        padding: 16px 20px;
    }

    .table-kumari tbody tr {
        border-bottom: 1px solid #333333;
        transition: background-color 0.2s ease;
    }

    .table-kumari tbody tr:hover {
        background-color: rgba(255, 215, 0, 0.05);
    }

    .btn-edit {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: white;
        border: none;
        padding: 6px 10px;
        border-radius: 6px;
        transition: all 0.2s ease;
    }

    .btn-edit:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    }

    .btn-delete {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
        border: none;
        padding: 6px 10px;
        border-radius: 6px;
        transition: all 0.2s ease;
    }

    .btn-delete:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
    }

    .page-header {
        background: linear-gradient(135deg, rgba(229, 9, 20, 0.1) 0%, rgba(255, 215, 0, 0.05) 100%);
        padding: 30px;
        border-radius: 16px;
        border: 1px solid #333333;
    }
</style>
