@model List<TicketPrice>
@{
    ViewData["Title"] = "Ticket Prices";
}

<div class="page-header">
    <h2><i class="bi bi-tags me-2"></i>Ticket Prices</h2>
    <p>Manage pricing categories for cinema tickets</p>
</div>

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">All Pricing Plans</h5>
        <a asp-action="Create" class="btn btn-kumari btn-sm"><i class="bi bi-plus-circle me-1"></i>Add Price</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-kumari table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Category</th>
                        <th>Price (Rs.)</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tp in Model)
                    {
                        <tr>
                            <td><strong>@tp.TicketPriceID</strong></td>
                            <td><span class="badge bg-info">@tp.Category</span></td>
                            <td><strong>Rs. @tp.Price.ToString("F2")</strong></td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@tp.TicketPriceID" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@tp.TicketPriceID" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white text-muted small">Total Pricing Plans: <strong>@Model.Count</strong></div>
</div>
