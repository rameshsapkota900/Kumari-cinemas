@model List<BookingHistoryViewModel>
@{
    ViewData["Title"] = "My Bookings - Kumari Cinemas";
}

<!-- Page Header -->
<div class="page-header mb-5">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="display-5" style="color: #ffd700; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
                <i class="bi bi-bookmark-check me-3"></i>My Bookings
            </h1>
            <p style="color: #b0b0b0; font-size: 16px;">View your booking history and tickets</p>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="stat-card bookings">
            <div class="card-body">
                <i class="bi bi-journal-check stat-icon"></i>
                <div class="stat-label">Total Bookings</div>
                <div class="stat-value">@Model.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card tickets">
            <div class="card-body">
                <i class="bi bi-ticket-perforated stat-icon"></i>
                <div class="stat-label">Total Tickets</div>
                <div class="stat-value">@Model.Sum(b => b.TicketCount)</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card revenue">
            <div class="card-body">
                <i class="bi bi-currency-dollar stat-icon"></i>
                <div class="stat-label">Total Spent</div>
                <div class="stat-value">₹@Model.Sum(b => b.TotalAmount).ToString("F0")</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card" style="background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%); border: 2px solid #333333; border-radius: 12px; text-align: center; padding: 60px 20px;">
        <i class="bi bi-inbox" style="font-size: 64px; color: #666;"></i>
        <h4 style="color: #b0b0b0; margin-top: 20px;">No Bookings Yet</h4>
        <p style="color: #999; margin-bottom: 20px;">You haven't made any bookings yet. Start booking your favorite movies now!</p>
        <a href="@Url.Action("Theaters")" class="btn btn-kumari" style="background: linear-gradient(135deg, #e50914 0%, #b20710 100%); border: none;">
            <i class="bi bi-film me-2"></i>Browse Movies
        </a>
    </div>
}
else
{
    <div class="bookings-container">
        @foreach (var booking in Model.OrderByDescending(b => b.BookingDate))
        {
            var isUpcoming = booking.LastShowDate > DateTime.Now;
            var statusColor = booking.PaymentStatus == "Completed" ? "#10b981" : (booking.PaymentStatus == "Pending" ? "#f59e0b" : "#ef4444");
            var statusBg = booking.PaymentStatus == "Completed" ? "rgba(16, 185, 129, 0.2)" : (booking.PaymentStatus == "Pending" ? "rgba(245, 158, 11, 0.2)" : "rgba(239, 68, 68, 0.2)");

            <div class="card booking-card" style="background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%); border: 2px solid #333333; border-radius: 12px; margin-bottom: 20px;">
                <div class="card-body">
                    <div class="row align-items-start">
                        <!-- Booking Info -->
                        <div class="col-lg-8">
                            <div class="row">
                                <div class="col-md-6">
                                    <small style="color: #ffd700; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Booking ID</small>
                                    <h6 style="color: #f0f0f0; margin: 4px 0 12px 0; font-family: monospace;">@booking.BookingID.ToString("D8")</h6>

                                    <small style="color: #b0b0b0; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Booked On</small>
                                    <div style="color: #f0f0f0; margin: 4px 0 12px 0;">
                                        @booking.BookingDate.ToString("MMM dd, yyyy @ hh:mm tt")
                                    </div>

                                    <small style="color: #b0b0b0; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Show Date</small>
                                    <div style="color: #f0f0f0;">
                                        @booking.LastShowDate.Value.ToString("MMM dd, yyyy")
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <small style="color: #b0b0b0; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Tickets</small>
                                    <h4 style="color: #10b981; margin: 4px 0 12px 0;">@booking.TicketCount @(booking.TicketCount > 1 ? "Seats" : "Seat")</h4>

                                    <small style="color: #b0b0b0; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Amount</small>
                                    <h5 style="color: #ffd700; margin: 4px 0 12px 0;">₹@booking.TotalAmount.ToString("F2")</h5>

                                    <small style="color: #b0b0b0; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Payment</small>
                                    <div style="background: @statusBg; color: @statusColor; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; border: 1px solid @statusColor; width: fit-content;">
                                        <i class="bi bi-@(booking.PaymentStatus == "Completed" ? "check-circle" : (booking.PaymentStatus == "Pending" ? "clock-history" : "x-circle")) me-1"></i>
                                        @booking.PaymentStatus
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Status & Actions -->
                        <div class="col-lg-4">
                            <div style="text-align: right;">
                                @if (isUpcoming)
                                {
                                    <div style="background: rgba(16, 185, 129, 0.2); padding: 12px; border-radius: 6px; border: 1px solid #10b981; margin-bottom: 12px;">
                                        <span style="color: #10b981; font-size: 12px; font-weight: 600;">
                                            <i class="bi bi-clock me-1"></i>UPCOMING SHOW
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div style="background: rgba(107, 114, 128, 0.2); padding: 12px; border-radius: 6px; border: 1px solid #6b7280; margin-bottom: 12px;">
                                        <span style="color: #9ca3af; font-size: 12px; font-weight: 600;">
                                            <i class="bi bi-check me-1"></i>COMPLETED
                                        </span>
                                    </div>
                                }

                                <a href="@Url.Action("BookingDetails", new { bookingId = booking.BookingID })" class="btn btn-sm btn-kumari w-100" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); border: none; margin-bottom: 8px;">
                                    <i class="bi bi-eye me-1"></i>View Details
                                </a>

                                @if (isUpcoming && booking.PaymentStatus == "Completed")
                                {
                                    <button class="btn btn-sm btn-outline-danger w-100" style="border-color: #666; color: #ef4444;" onclick="confirmCancel(@booking.BookingID)">
                                        <i class="bi bi-trash me-1"></i>Cancel Booking
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .page-header {
        background: linear-gradient(135deg, rgba(229, 9, 20, 0.1) 0%, rgba(255, 215, 0, 0.05) 100%);
        padding: 30px;
        border-radius: 16px;
        border: 1px solid #333333;
    }

    .stat-card {
        border: 2px solid #333333;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        border-color: #ffd700;
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(229, 9, 20, 0.2);
    }

    .booking-card {
        transition: all 0.3s ease;
    }

    .booking-card:hover {
        border-color: #ffd700;
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(229, 9, 20, 0.3);
    }

    .bookings-container {
        animation: slideUp 0.4s ease-out;
    }

    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 768px) {
        .booking-card .row {
            flex-direction: column;
        }

        .booking-card .col-lg-4 {
            text-align: left;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #333;
        }

        h1 {
            font-size: 32px;
        }
    }
</style>

@section Scripts {
    <script>
        function confirmCancel(bookingId) {
            if (confirm('Are you sure you want to cancel this booking? This action cannot be undone.')) {
                // In a real app, this would POST to a cancel endpoint
                alert('Booking cancellation initiated. You will receive a refund within 3-5 business days.');
            }
        }
    </script>
}
