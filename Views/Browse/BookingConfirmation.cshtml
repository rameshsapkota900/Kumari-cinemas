@model BookingConfirmationViewModel
@{
    ViewData["Title"] = "Booking Confirmed - " + Model.BookingID;
}

<!-- Success Animation Container -->
<div class="text-center mb-5">
    <div style="display: inline-block; animation: successPulse 0.6s ease-out;">
        <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto; box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3);">
            <i class="bi bi-check-lg" style="font-size: 48px; color: white;"></i>
        </div>
    </div>
</div>

<!-- Confirmation Header -->
<div class="text-center mb-5">
    <h1 class="display-4" style="color: #10b981; margin-bottom: 12px;">
        Booking Confirmed!
    </h1>
    <p style="color: #b0b0b0; font-size: 18px;">
        Your tickets have been successfully booked and payment is confirmed.
    </p>
</div>

<div class="row g-4 mb-5">
    <!-- Booking Reference Card -->
    <div class="col-lg-8">
        <div class="card" style="background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%); border: 2px solid #10b981; border-radius: 12px;">
            <div class="card-header" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none;">
                <h4 class="mb-0 text-white">
                    <i class="bi bi-ticket-perforated me-2"></i>Your Booking Details
                </h4>
            </div>

            <div class="card-body">
                <!-- Booking ID -->
                <div style="background: rgba(16, 185, 129, 0.1); padding: 16px; border-radius: 8px; margin-bottom: 24px; border: 2px solid #10b981;">
                    <small style="color: #b0b0b0; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Booking Reference Number</small>
                    <h3 style="color: #10b981; margin: 8px 0 0 0; font-family: monospace; letter-spacing: 2px;">@Model.BookingID.ToString("D8")</h3>
                    <small style="color: #b0b0b0;">Save this number for your records</small>
                </div>

                <!-- Movie & Show Details -->
                <div style="border-bottom: 1px solid #333; padding-bottom: 20px; margin-bottom: 20px;">
                    <h5 style="color: #ffd700; margin-bottom: 12px;">
                        <i class="bi bi-film me-2"></i>@Model.MovieTitle
                    </h5>
                    <div class="row">
                        <div class="col-md-6">
                            <small style="color: #b0b0b0;">Date</small>
                            <div style="color: #f0f0f0; font-weight: 600;">@Model.ShowDate.ToString("dddd, MMM dd, yyyy")</div>
                        </div>
                        <div class="col-md-6">
                            <small style="color: #b0b0b0;">Time</small>
                            <div style="color: #f0f0f0; font-weight: 600;">@Model.ShowTime</div>
                        </div>
                    </div>
                </div>

                <!-- Theater & Hall -->
                <div style="border-bottom: 1px solid #333; padding-bottom: 20px; margin-bottom: 20px;">
                    <div class="row">
                        <div class="col-md-6">
                            <small style="color: #b0b0b0; text-transform: uppercase; font-weight: 600;">Theater</small>
                            <h6 style="color: #ffd700; margin: 8px 0;">@Model.TheaterName</h6>
                            <small style="color: #b0b0b0;">@Model.TheaterCity</small>
                        </div>
                        <div class="col-md-6">
                            <small style="color: #b0b0b0; text-transform: uppercase; font-weight: 600;">Hall</small>
                            <h6 style="color: #10b981; margin: 8px 0;">@Model.HallName</h6>
                        </div>
                    </div>
                </div>

                <!-- Selected Seats -->
                <div>
                    <h6 style="color: #ffd700; margin-bottom: 12px;">
                        <i class="bi bi-chairs me-2"></i>Your Seats
                    </h6>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(80px, 1fr)); gap: 8px;">
                        @foreach (var seat in Model.Tickets)
                        {
                            <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(16, 185, 129, 0.1) 100%); padding: 10px; border-radius: 6px; text-align: center; border: 1px solid #10b981;">
                                <div style="color: #10b981; font-weight: 600; font-size: 16px;">@seat.SeatNumber</div>
                                <small style="color: #b0b0b0;">@seat.Category</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment & Next Steps Card -->
    <div class="col-lg-4">
        <!-- Payment Status -->
        <div class="card" style="background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%); border: 2px solid #10b981; border-radius: 12px; margin-bottom: 20px;">
            <div class="card-header" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none;">
                <h5 class="mb-0 text-white">
                    <i class="bi bi-check-circle me-2"></i>Payment Status
                </h5>
            </div>
            <div class="card-body text-center">
                <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                    <i class="bi bi-check-lg" style="font-size: 32px; color: white;"></i>
                </div>
                <h6 style="color: #10b981; margin-bottom: 8px;">Payment Confirmed</h6>
                <div style="background: rgba(16, 185, 129, 0.1); padding: 12px; border-radius: 6px; border: 1px solid #10b981;">
                    <small style="color: #b0b0b0;">Amount Paid</small>
                    <div style="color: #10b981; font-weight: 700; font-size: 24px;">₹@Model.TotalAmount.ToString("F2")</div>
                </div>
                <small style="color: #b0b0b0; display: block; margin-top: 8px;">
                    Payment Method: @Model.PaymentMethod
                </small>
            </div>
        </div>

        <!-- Booking Details -->
        <div class="card" style="background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%); border: 2px solid #3b82f6; border-radius: 12px; margin-bottom: 20px;">
            <div class="card-header" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); border: none;">
                <h5 class="mb-0 text-white">
                    <i class="bi bi-info-circle me-2"></i>Booking Info
                </h5>
            </div>
            <div class="card-body" style="font-size: 13px;">
                <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #333;">
                    <span style="color: #b0b0b0;">Ticket Quantity</span>
                    <span style="color: #f0f0f0; font-weight: 600;">@Model.Tickets.Count @(Model.Tickets.Count > 1 ? "seats" : "seat")</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #333;">
                    <span style="color: #b0b0b0;">Booking Date</span>
                    <span style="color: #f0f0f0; font-weight: 600;">@Model.BookingDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 8px 0;">
                    <span style="color: #b0b0b0;">Status</span>
                    <span style="color: #10b981; font-weight: 600;">✓ Confirmed</span>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div style="display: grid; gap: 10px;">
            <a href="@Url.Action("MyBookings")" class="btn btn-kumari w-100" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none; padding: 12px; font-weight: 600;">
                <i class="bi bi-bookmark me-2"></i>View My Bookings
            </a>
            <a href="@Url.Action("Theaters")" class="btn btn-outline-secondary w-100" style="border-color: #666; color: #b0b0b0; padding: 12px;">
                <i class="bi bi-arrow-right me-2"></i>Book More Tickets
            </a>
        </div>

        <!-- Important Info -->
        <div style="background: rgba(245, 158, 11, 0.1); padding: 12px; border-radius: 6px; border-left: 3px solid #f59e0b; margin-top: 20px; color: #f59e0b; font-size: 12px;">
            <i class="bi bi-exclamation-circle me-2"></i>
            <strong>Important:</strong> Please arrive 15 minutes before show start
        </div>
    </div>
</div>

<!-- Ticket Information -->
<div class="card" style="background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%); border: 2px solid #333333; border-radius: 12px;">
    <div class="card-header" style="background: linear-gradient(135deg, #e50914 0%, #b20710 100%); border: none;">
        <h5 class="mb-0 text-white">
            <i class="bi bi-printer me-2"></i>Tickets
        </h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            @foreach (var ticket in Model.Tickets)
            {
                <div class="col-md-6">
                    <div style="background: #0a0d14; padding: 16px; border-radius: 8px; border: 1px dashed #666;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <h6 style="color: #ffd700; margin: 0;">TICKET</h6>
                            <small style="color: #666; font-family: monospace;">@ticket.TicketID</small>
                        </div>
                        <div style="border-top: 1px dashed #666; padding-top: 12px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <small style="color: #b0b0b0;">Seat</small>
                                <strong style="color: #f0f0f0;">@ticket.SeatNumber</strong>
                            </div>
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <small style="color: #b0b0b0;">Category</small>
                                <strong style="color: #f0f0f0;">@ticket.Category</strong>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <small style="color: #b0b0b0;">Price</small>
                                <strong style="color: #10b981;">₹@ticket.Price.ToString("F2")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Email Confirmation Notice -->
<div style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(16, 185, 129, 0.05) 100%); padding: 24px; border-radius: 12px; border: 1px solid #3b82f6; margin-top: 24px; text-align: center;">
    <i class="bi bi-envelope-check" style="font-size: 32px; color: #3b82f6; margin-bottom: 12px; display: block;"></i>
    <h5 style="color: #3b82f6; margin-bottom: 8px;">Confirmation Email Sent</h5>
    <p style="color: #b0b0b0; margin: 0;">
        A confirmation email with your booking details and tickets has been sent to <strong>@Model.UserEmail</strong>
    </p>
    <small style="color: #666; display: block; margin-top: 8px;">
        Check your spam folder if you don't receive it within 5 minutes
    </small>
</div>

<style>
    @keyframes successPulse {
        0% {
            transform: scale(0.8);
            opacity: 0;
        }
        50% {
            transform: scale(1.1);
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @media (max-width: 768px) {
        .display-4 {
            font-size: 28px;
        }
    }
</style>
