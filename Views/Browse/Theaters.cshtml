@model List<Theater>
@{
    ViewData["Title"] = "Browse Theaters - Kumari Cinemas";
}

<!-- Page Header -->
<div class="page-header mb-5">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-5" style="color: #ffd700; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
                <i class="bi bi-buildings me-3"></i>Select Your Theater
            </h1>
            <p style="color: #b0b0b0; font-size: 18px;">Choose from our premium cinema locations</p>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5">
        <i class="bi bi-info-circle" style="font-size: 48px;"></i>
        <h4 class="mt-3">No Theaters Available</h4>
        <p>Please check back soon for new theater locations.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var theater in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="theater-card h-100 shadow-lg" onclick="location.href='@Url.Action("Halls", new { theaterId = theater.TheaterID })'" style="cursor: pointer;">
                    <!-- Theater Header with Icon -->
                    <div style="background: linear-gradient(135deg, #e50914 0%, #b20710 100%); padding: 20px; border-radius: 12px 12px 0 0; margin: -20px -20px 0 -20px; margin-bottom: 20px;">
                        <div class="d-flex align-items-center justify-content-between">
                            <h4 class="text-white mb-0" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">
                                <i class="bi bi-film me-2"></i>@theater.Name
                            </h4>
                            <span class="badge bg-warning text-dark" style="font-size: 12px; padding: 6px 12px;">
                                <i class="bi bi-star-fill me-1"></i>Premium
                            </span>
                        </div>
                    </div>

                    <!-- Theater Info -->
                    <div class="card-body" style="color: #f0f0f0;">
                        <div class="mb-3" style="border-bottom: 1px solid #333;">
                            <i class="bi bi-geo-alt" style="color: #ffd700;"></i>
                            <strong>Location</strong>
                            <p class="mb-0" style="color: #b0b0b0;">@theater.City</p>
                        </div>

                        <div class="mb-3" style="border-bottom: 1px solid #333;">
                            <i class="bi bi-house-door" style="color: #ffd700;"></i>
                            <strong>Address</strong>
                            <p class="mb-0" style="color: #b0b0b0;">@theater.Address</p>
                        </div>

                        <!-- CTA Button -->
                        <div class="mt-4">
                            <a href="@Url.Action("Halls", new { theaterId = theater.TheaterID })" 
                               class="btn btn-kumari w-100"
                               style="background: linear-gradient(135deg, #e50914 0%, #b20710 100%); border: none;">
                                <i class="bi bi-door-open me-2"></i>View Halls
                                <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Footer Stats -->
                    <div style="background: #1a1f2e; padding: 12px 16px; border-radius: 0 0 12px 12px; margin: 0 -20px -20px -20px; text-align: center; color: #ffd700; font-size: 13px; font-weight: 600;">
                        <i class="bi bi-play-circle me-1"></i>Click to explore shows
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .theater-card {
        background: linear-gradient(135deg, #1e2936 0%, #252d3d 100%);
        border: 2px solid #333333;
        border-radius: 16px;
        padding: 20px;
        transition: all 0.35s cubic-bezier(0.34, 0.1, 0.68, 0.55);
        position: relative;
        overflow: hidden;
    }

    .theater-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent 0%, rgba(255, 215, 0, 0.1) 50%, transparent 100%);
        transition: left 0.35s cubic-bezier(0.34, 0.1, 0.68, 0.55);
        pointer-events: none;
    }

    .theater-card:hover {
        border-color: #ffd700;
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(229, 9, 20, 0.4) !important;
    }

    .theater-card:hover::before {
        left: 100%;
    }

    .page-header {
        background: linear-gradient(135deg, rgba(229, 9, 20, 0.1) 0%, rgba(255, 215, 0, 0.05) 100%);
        padding: 30px;
        border-radius: 16px;
        border: 1px solid #333333;
    }

    @media (max-width: 768px) {
        .theater-card {
            padding: 16px;
        }
        
        h1 {
            font-size: 32px !important;
        }
    }
</style>
