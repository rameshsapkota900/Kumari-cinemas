<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KumariCinemas</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Google Fonts - Inter (modern clean font) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Animate.css for subtle animations -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Sidebar + Main wrapper -->
    <div class="app-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-film"></i>
                <span>Kumari Cinemas</span>
                <small style="display: block; font-size: 10px; font-weight: 400; letter-spacing: 0.8px; opacity: 0.7;">PROFESSIONAL EDITION v2.0</small>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-label">Main</div>
                <a class="sidebar-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
                </a>

                <div class="nav-section-label">Management</div>
                <a class="sidebar-link" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people"></i><span>Users</span>
                </a>
                <a class="sidebar-link" asp-controller="TheaterCityHall" asp-action="Index">
                    <i class="bi bi-building"></i><span>Theaters & Halls</span>
                </a>
                <a class="sidebar-link" asp-controller="Movies" asp-action="Index">
                    <i class="bi bi-camera-reels"></i><span>Movies</span>
                </a>
                <a class="sidebar-link" asp-controller="Showtimes" asp-action="Index">
                    <i class="bi bi-clock-history"></i><span>Showtimes</span>
                </a>
                <a class="sidebar-link" asp-controller="TicketPrices" asp-action="Index">
                    <i class="bi bi-tags"></i><span>Ticket Prices</span>
                </a>
                <a class="sidebar-link" asp-controller="Seats" asp-action="Index">
                    <i class="bi bi-grid-3x3-gap"></i><span>Seats</span>
                </a>
                <a class="sidebar-link" asp-controller="Tickets" asp-action="Index">
                    <i class="bi bi-ticket-perforated"></i><span>Tickets</span>
                </a>
                <a class="sidebar-link" asp-controller="Cancellations" asp-action="Index">
                    <i class="bi bi-x-circle"></i><span>Cancellations</span>
                </a>

                <div class="nav-section-label">Reports & Analytics</div>
                <a class="sidebar-link" asp-controller="UserTicket" asp-action="Index">
                    <i class="bi bi-person-badge"></i><span>User Tickets</span>
                </a>
                <a class="sidebar-link" asp-controller="TheaterCityHallMovie" asp-action="Index">
                    <i class="bi bi-collection-play"></i><span>Hall Movies</span>
                </a>
                <a class="sidebar-link" asp-controller="Occupancy" asp-action="Index">
                    <i class="bi bi-bar-chart-line"></i><span>Occupancy</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <small><i class="bi bi-film me-1"></i>Kumari Cinemas v1.0</small>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="main-content">
            <!-- Top Bar -->
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle" title="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>
                <div class="topbar-title">
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="topbar-right">
                    <span class="status-badge online" style="background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border: 1px solid #a7f3d0;"><i class="bi bi-person-circle me-1"></i>Admin Panel</span>
                </div>
            </header>

            <!-- Page Content -->
            <main class="page-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show animate__animated animate__fadeInDown" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show animate__animated animate__fadeInDown" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                <div class="animate__animated animate__fadeIn">
                    @RenderBody()
                </div>
            </main>

            <!-- Footer -->
            <footer class="app-footer">
                <small>
                    KumariCinemas Management System &copy; 2025 &mdash;
                    CC6012NT Data and Web Development &mdash;
                    Ramesh Sapkota (23049378)
                </small>
            </footer>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
