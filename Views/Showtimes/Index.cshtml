@model List<Show>
@{
    ViewData["Title"] = "Showtimes Details";
}

<div class="page-header">
    <h2><i class="bi bi-clock me-2"></i>Show Schedule</h2>
    <p>Manage movie screenings, timings, and hall assignments</p>
</div>

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">All Showtimes</h5>
        <a asp-action="Create" class="btn btn-kumari btn-sm"><i class="bi bi-plus-circle me-1"></i>Add Show</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-kumari table-hover mb-0">
                <thead>
                    <tr>
                        <th>ShowID</th>
                        <th>Show Date</th>
                        <th>Show Time</th>
                        <th>Status</th>
                        <th>Movie</th>
                        <th>Hall</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><strong>@s.ShowID</strong></td>
                            <td>@s.ShowDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge bg-secondary">@s.ShowTime</span></td>
                            <td>
                                @if (s.ShowStatus == "Active" || s.ShowStatus == "Scheduled")
                                {
                                    <span class="badge bg-success">@s.ShowStatus</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@s.ShowStatus</span>
                                }
                            </td>
                            <td>@s.MovieTitle</td>
                            <td>@s.HallName <span class="text-muted small">(@s.TheaterName)</span></td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@s.ShowID" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@s.ShowID" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white text-muted small">Total Shows: <strong>@Model.Count</strong></div>
</div>
