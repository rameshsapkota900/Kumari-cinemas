@model Show
@{
    ViewData["Title"] = "Delete Show";
}
<div class="page-header">
    <h2><i class="bi bi-trash me-2"></i>Cancel Show</h2>
    <p>Confirm removal of this screening from the schedule</p>
</div>
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="delete-confirm text-center">
            <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
            <h4 class="mt-3">Delete Show #@Model.ShowID?</h4>
            <p class="text-muted">Date: @Model.ShowDate.ToString("yyyy-MM-dd") | Time: @Model.ShowTime | Status: @Model.ShowStatus</p>
            <p class="text-muted">Movie: @Model.MovieTitle | Hall: @Model.HallName</p>
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ShowID" />
                <a asp-action="Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left me-2"></i>Cancel</a>
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-2"></i>Confirm Delete</button>
            </form>
        </div>
    </div>
</div>
